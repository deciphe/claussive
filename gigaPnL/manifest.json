{
  "manifest_version": 3,
  "name": "MassivePnL",
  "version": "0.5.0",
  "description": "Hyper-compact Vest live PnL HUD, multi-account copier, verified demo panic flatten, and always-on-top popout.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://vestmarkets.com/*",
    "https://*.vestmarkets.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vestmarkets.com/*",
        "https://*.vestmarkets.com/*"
      ],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://vestmarkets.com/*",
        "https://*.vestmarkets.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "MassivePnL"
  }
}
